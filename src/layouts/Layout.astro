---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	/** Path (e.g. `/hype/hero.webp`) or full URL for Open Graph / Twitter cards */
	ogImage?: string;
	ogImageAlt?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	keywords?: string;
	/** Override the canonical path. Defaults to the current page. */
	canonicalPath?: string;
	noindex?: boolean;
}

const siteOrigin = Astro.site?.origin ?? 'https://outorbit.games';

const {
	title,
	description = 'Outorbit Games is an independent studio. Our first game, HYPE: Highschool Yokai Patrol & Exorcism, is a co-op horror game coming soon on Steam.',
	ogImage,
	ogImageAlt = 'HYPE: Highschool Yokai Patrol & Exorcism',
	ogImageWidth,
	ogImageHeight,
	keywords = 'Outorbit Games, indie game studio, HYPE, Highschool Yokai Patrol and Exorcism, co-op horror',
	canonicalPath,
	noindex = false,
} = Astro.props;

const pathSource = canonicalPath ?? Astro.url.pathname;
const normalizedPath =
	pathSource === '/' ? '/' : pathSource.endsWith('/') ? pathSource : `${pathSource}/`;
const canonical = new URL(normalizedPath, siteOrigin).href;

const resolvedOgImage = ogImage
	? ogImage.startsWith('http://') || ogImage.startsWith('https://')
		? ogImage
		: `${siteOrigin}${ogImage.startsWith('/') ? ogImage : `/${ogImage}`}`
	: null;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400..800&display=swap" rel="stylesheet" />

		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Outorbit Games" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
		{resolvedOgImage && <meta property="og:image:alt" content={ogImageAlt} />}
		{resolvedOgImage && ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
		{resolvedOgImage && ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:url" content={canonical} />
		{resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
		{resolvedOgImage && <meta name="twitter:image:alt" content={ogImageAlt} />}
	</head>
	<body class="bg-black text-white min-h-screen">
		<slot />
	</body>
</html>
