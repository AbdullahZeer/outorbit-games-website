---
import Layout from '../layouts/Layout.astro';
import Starfield from '../components/Starfield.astro';
import Logo from '../components/Logo.astro';
import { Mail } from 'lucide-astro';
import XIcon from '../components/icons/XIcon.astro';
import TikTokIcon from '../components/icons/TikTokIcon.astro';
import WishlistLink from '../components/WishlistLink.astro';
import ScreamFest from '../components/ScreamFest.astro';
import { gameTitle } from '../data/hype';

const title = "Outorbit Games — Exploring Beyond Orbit";
const description =
	"Outorbit Games is an independent studio. Our first game, HYPE: Highschool Yokai Patrol & Exorcism, is a co-op horror game coming soon on Steam.";
const keywords =
	"Outorbit Games, indie game studio, HYPE, Highschool Yokai Patrol and Exorcism, co-op horror, Steam";
---

<Layout
	title={title}
	description={description}
	keywords={keywords}
	ogImage="/og/hype.jpg"
	ogImageAlt="HYPE: Highschool Yokai Patrol & Exorcism key art"
	ogImageWidth={1200}
	ogImageHeight={630}
>
	<Starfield />
	
	<main class="relative min-h-screen flex flex-col items-center justify-center px-4 py-16">
		<!-- Logo Header -->
		<div class="mb-12 animate-fade-in">
			<Logo />
		</div>

		<!-- Main Content Card -->
		<div class="w-full max-w-[65ch] backdrop-blur-md bg-white/5 border border-white/10 rounded-lg p-8 md:p-12 shadow-2xl animate-fade-in-delay">
			<!-- Studio Name -->
			<h1 class="text-3xl md:text-4xl font-light mb-6 text-center tracking-wide">
				Outorbit
			</h1>

			<!-- Title/Tagline -->
			<p class="text-lg md:text-xl text-gray-300 text-center mb-6 leading-relaxed">
				Outorbit is an independent studio exploring beyond orbit.
			</p>

			<!-- Studio Philosophy -->
			<div class="text-base md:text-lg text-gray-300 text-center mb-8 leading-relaxed max-w-[65ch] mx-auto">
				<p class="mb-2">
					At Outorbit, we don't aim to invent new genres. We refine them.
				</p>
				<p>
					We believe innovation happens when we stay close to what feels familiar and push it just far enough to feel new again.
				</p>
			</div>

			<!-- Contact -->
			<div class="text-center mb-10">
				<a
					href="mailto:contact@outorbit.games"
					class="inline-flex items-center gap-2 text-white hover:text-[#B0F0FF] transition-colors duration-300 underline decoration-white/30 hover:decoration-[#B0F0FF]/50 underline-offset-4"
				>
					<Mail class="w-4 h-4" />
					contact@outorbit.games
				</a>
			</div>

			<!-- Social Links -->
			<div class="flex justify-center gap-6 flex-wrap">
				<a
					href="https://twitter.com/outorbitgames"
					target="_blank"
					rel="noopener noreferrer"
					class="text-gray-400 hover:text-white transition-colors duration-300"
					aria-label="X (Twitter)"
				>
					<XIcon class="w-5 h-5" />
				</a>
				<a
					href="https://tiktok.com/@outorbitgames"
					target="_blank"
					rel="noopener noreferrer"
					class="text-gray-400 hover:text-white transition-colors duration-300"
					aria-label="TikTok"
				>
					<TikTokIcon class="w-5 h-5" />
				</a>
			</div>
		</div>

		<article class="mt-8 w-full max-w-xl overflow-hidden rounded-lg border border-white/10 bg-white/5 shadow-2xl backdrop-blur-md animate-fade-in-delay" aria-labelledby="hype-heading">
			<a href="/hype" class="block">
				<img
					src="/hype/hero.webp"
					alt="Key art for HYPE: Highschool Yokai Patrol & Exorcism"
					width="1232"
					height="706"
					class="aspect-video w-full object-cover object-[center_32%]"
				/>
			</a>
			<div class="px-6 py-6 text-center md:px-8">
				<p class="mb-3 text-xs tracking-[0.18em] text-gray-400 uppercase">Coming soon on Steam</p>
				<ScreamFest class="mb-3" />
				<h2 id="hype-heading" class="mb-3 text-xl font-light tracking-wide md:text-2xl">
					<a href="/hype" class="hover:text-[#B0F0FF]">{gameTitle}</a>
				</h2>
				<p class="mx-auto mb-6 max-w-[52ch] text-sm leading-relaxed text-gray-300 md:text-base">
					A 1–4 player online co-op horror game. Run a highschool occult club, follow the rumors by day, and seal the curse after dark.
				</p>
				<div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
					<WishlistLink content="home" variant="home" />
					<a
						href="/hype"
						class="inline-flex items-center justify-center rounded-md border border-white/20 px-5 py-3 text-sm text-white transition-colors hover:border-white hover:text-[#B0F0FF]"
					>
						Game page
					</a>
				</div>
			</div>
		</article>

		<!-- Footer -->
		<footer class="mt-16 text-center text-gray-500 text-sm animate-fade-in-delay-2">
			<p>© Outorbit • All Rights Reserved</p>
		</footer>
	</main>
</Layout>

<style>
	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.animate-fade-in {
		animation: fade-in 1.5s ease-in-out;
	}

	.animate-fade-in-delay {
		animation: fade-in 1.5s ease-in-out 0.3s both;
	}

	.animate-fade-in-delay-2 {
		animation: fade-in 1.5s ease-in-out 0.6s both;
	}
</style>
