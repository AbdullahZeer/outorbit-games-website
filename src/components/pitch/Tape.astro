---
interface Props {
	src?: string;
	class?: string;
	alt?: string;
	style?: string;
	width?: number;
	height?: number;
}

const {
	src = '/hype/pitch/tape/strip-mid.webp',
	class: className = '',
	alt = '',
	style,
	width = 180,
	height = 34,
} = Astro.props;
---

<img
	src={src}
	alt={alt}
	class:list={['pitch-tape', className]}
	style={style}
	aria-hidden={alt ? undefined : 'true'}
	width={width}
	height={height}
	loading="lazy"
	decoding="async"
/>
