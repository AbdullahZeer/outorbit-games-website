---
interface Props {
	src?: string;
	class?: string;
	alt?: string;
	style?: string;
}

const {
	src = '/hype/pitch/tape/strip-mid.svg',
	class: className = '',
	alt = '',
	style,
} = Astro.props;
---

<img src={src} alt={alt} class:list={['pitch-tape', className]} style={style} aria-hidden={alt ? undefined : 'true'} width="180" height="34" loading="lazy" decoding="async" />
