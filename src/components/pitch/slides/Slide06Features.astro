---
import SlideChrome from '../SlideChrome.astro';

const features = [
	{
		title: 'Readable co-op roles',
		body: 'Clear jobs under pressure — sealing, defense, distraction, callouts — so every player stays useful.',
	},
	{
		title: 'Tape sealing fantasy',
		body: 'Team-based sealing with masking-tape ritual energy as the signature interaction.',
	},
	{
		title: 'Folklore cases',
		body: 'Japanese yokai-inspired encounters with comedy-horror tone, not pure jump-scare spam.',
	},
	{
		title: 'Escalating nights',
		body: 'Pressure climbs as the anchor fight continues — coordination matters more than aim alone.',
	},
];
---

<SlideChrome>
	<div class="flex h-full flex-col">
		<p class="pitch-bold mb-2 text-[clamp(0.65rem,1.1vw,0.8rem)] tracking-[0.22em] text-[var(--pitch-gold-deep)] uppercase">
			Features
		</p>
		<h2 class="pitch-bold mb-5 text-[clamp(1.4rem,3.2vw,2.35rem)] leading-[1.05]">
			What makes a night stick.
		</h2>
		<div class="grid min-h-0 flex-1 gap-3 sm:grid-cols-2">
			{features.map((f) => (
				<article class="border border-black/12 bg-white/40 p-4 md:p-5">
					<h3 class="pitch-bold text-[clamp(0.95rem,1.6vw,1.2rem)]">{f.title}</h3>
					<p class="mt-2 text-[clamp(0.78rem,1.2vw,0.95rem)] leading-relaxed text-[var(--pitch-ink-muted)]">{f.body}</p>
				</article>
			))}
		</div>
	</div>
</SlideChrome>
