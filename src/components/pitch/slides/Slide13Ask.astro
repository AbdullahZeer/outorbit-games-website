---
import SlideChrome from '../SlideChrome.astro';
---

<SlideChrome>
	<div class="flex h-full flex-col">
		<h2 class="pitch-title">The Ask</h2>
		<p class="pitch-subtitle">HYPE is built for anime creators in mind</p>
		<div class="mt-[clamp(1.75rem,6vh,3.5rem)] max-w-[36rem] space-y-5">
			<p class="pitch-body">
				VTubers already love anime and chaotic<br />
				friendslop games.
			</p>
			<p class="pitch-body">
				HYPE gives them a natural format: supernatural<br />
				anime ghost-hunting with friends, where cute<br />
				school life collides with cursed yokai horror<br />
				and every run can create clip-ready panic.
			</p>
		</div>
	</div>
</SlideChrome>
