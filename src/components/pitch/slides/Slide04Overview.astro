---
import SlideChrome from '../SlideChrome.astro';
---

<SlideChrome>
	<div class="grid h-full gap-4 md:grid-cols-[1.05fr_0.95fr] md:gap-6">
		<div class="flex flex-col justify-between">
			<div>
				<p class="pitch-bold mb-2 text-[clamp(0.65rem,1.1vw,0.8rem)] tracking-[0.22em] text-[var(--pitch-gold-deep)] uppercase">
					Game overview
				</p>
				<h2 class="pitch-bold text-[clamp(1.4rem,3.2vw,2.4rem)] leading-[1.05]">
					H.Y.P.E
				</h2>
				<p class="mt-1 text-[clamp(0.8rem,1.3vw,1rem)] text-[var(--pitch-ink-muted)]">
					Highschool Youkai Patrol &amp; Exorcism
				</p>
				<p class="mt-4 max-w-[40ch] text-[clamp(0.85rem,1.4vw,1.05rem)] leading-relaxed text-[var(--pitch-ink-muted)]">
					An anime-inspired online co-op comedy-horror set in a Japanese high school. Players investigate by day,
					then enter a warped supernatural night space to locate and seal a cursed anchor.
				</p>
			</div>
			<ul class="mt-4 space-y-1.5 text-[clamp(0.78rem,1.2vw,0.95rem)]">
				<li>• Genre: Online co-op comedy-horror</li>
				<li>• Players: 1–4 online co-op</li>
				<li>• Setting: Japanese high school</li>
				<li>• Platforms: PC</li>
				<li>• Engine: Unity</li>
				<li>• Status: In development</li>
			</ul>
		</div>
		<div class="relative min-h-[10rem] overflow-hidden border border-black/15 bg-black">
			<img
				src="/hype/pitch/art/hero.webp"
				alt="Students with flashlights before a haunted school"
				class="absolute inset-0 h-full w-full object-cover object-[center_30%]"
				width="1600"
				height="900"
				loading="lazy"
				decoding="async"
			/>
		</div>
	</div>
</SlideChrome>
