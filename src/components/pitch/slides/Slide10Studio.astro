---
import SlideChrome from '../SlideChrome.astro';
---

<SlideChrome>
	<div class="flex h-full flex-col items-start justify-center">
		<img src="/logo.svg" alt="" class="mb-5 h-14 w-14 brightness-0 md:h-16 md:w-16" width="64" height="64" aria-hidden="true" />
		<p class="pitch-bold mb-2 text-[clamp(0.65rem,1.1vw,0.8rem)] tracking-[0.22em] text-[var(--pitch-gold-deep)] uppercase">
			Studio
		</p>
		<h2 class="pitch-bold text-[clamp(1.6rem,3.5vw,2.6rem)] leading-[1.05]">Outorbit Games</h2>
		<p class="mt-3 text-[clamp(0.9rem,1.4vw,1.1rem)] text-[var(--pitch-ink-muted)]">Riyadh, Saudi Arabia</p>
		<p class="mt-6 max-w-[42ch] text-[clamp(0.85rem,1.35vw,1.05rem)] leading-relaxed text-[var(--pitch-ink-muted)]">
			Independent studio exploring beyond orbit. We refine genres, push their limits, and find quiet innovation
			within familiar forms — starting with H.Y.P.E.
		</p>
	</div>
</SlideChrome>
