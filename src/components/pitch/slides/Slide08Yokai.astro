---
import SlideChrome from '../SlideChrome.astro';
---

<SlideChrome>
	<div class="grid h-full gap-4 md:grid-cols-[1.05fr_0.95fr] md:gap-6">
		<div class="relative min-h-[11rem] overflow-hidden border border-black/15 bg-black order-2 md:order-1">
			<img
				src="/hype/pitch/art/yurei.webp"
				alt="Yūrei yokai concept art"
				class="absolute inset-0 h-full w-full object-cover object-center"
				width="1400"
				height="788"
				loading="lazy"
				decoding="async"
			/>
		</div>
		<div class="flex flex-col justify-center order-1 md:order-2">
			<p class="pitch-bold mb-2 text-[clamp(0.65rem,1.1vw,0.8rem)] tracking-[0.22em] text-[var(--pitch-red)] uppercase">
				The threat
			</p>
			<h2 class="pitch-bold text-[clamp(1.35rem,3vw,2.2rem)] leading-[1.05]">
				Yokai with case-file energy.
			</h2>
			<p class="mt-4 max-w-[36ch] text-[clamp(0.85rem,1.35vw,1.05rem)] leading-relaxed text-[var(--pitch-ink-muted)]">
				Folklore-inspired encounters that escalate the night: eerie, readable, and built for co-op callouts —
				not just a single chase enemy.
			</p>
		</div>
	</div>
</SlideChrome>
