---
import SlideChrome from '../SlideChrome.astro';
---

<SlideChrome>
	<div class="flex h-full flex-col justify-between">
		<div>
			<p class="pitch-bold mb-3 text-[clamp(0.65rem,1.1vw,0.8rem)] tracking-[0.22em] text-[var(--pitch-gold-deep)] uppercase">
				The hook
			</p>
			<h2 class="pitch-bold max-w-[18ch] text-[clamp(1.6rem,4vw,3rem)] leading-[1.05]">
				Anime horror co-op that actually plays as a team.
			</h2>
			<p class="mt-5 max-w-[42ch] text-[clamp(0.9rem,1.55vw,1.15rem)] leading-relaxed text-[var(--pitch-ink-muted)]">
				By day you gather rumors. By night you seal cursed anchors while yokai pressure climbs —
				one seals, the others defend, distract, and call out.
			</p>
		</div>
		<ul class="grid gap-3 border-t border-black/10 pt-5 text-[clamp(0.8rem,1.3vw,1rem)] sm:grid-cols-3">
			<li class="border-l-2 border-[var(--pitch-gold)] pl-3">
				<span class="pitch-bold block">1–4 players</span>
				<span class="text-[var(--pitch-ink-muted)]">Online co-op</span>
			</li>
			<li class="border-l-2 border-[var(--pitch-red)] pl-3">
				<span class="pitch-bold block">Comedy-horror</span>
				<span class="text-[var(--pitch-ink-muted)]">Japanese high school</span>
			</li>
			<li class="border-l-2 border-black/30 pl-3">
				<span class="pitch-bold block">PC · Unity</span>
				<span class="text-[var(--pitch-ink-muted)]">In development</span>
			</li>
		</ul>
	</div>
</SlideChrome>
