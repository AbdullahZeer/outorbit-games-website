---
import SlideChrome from '../SlideChrome.astro';
---

<SlideChrome showCornerTape={false}>
	<div class="relative flex h-full flex-col overflow-hidden">
		<img
			src="/hype/pitch/art/hero-sm.webp"
			alt=""
			class="absolute inset-0 h-full w-full object-cover object-[center_32%] opacity-40"
			width="800"
			height="450"
			loading="lazy"
			decoding="async"
			aria-hidden="true"
		/>
		<div class="absolute inset-0 bg-[var(--pitch-paper)]/88" aria-hidden="true"></div>
		<div class="relative z-10 flex h-full flex-col items-center justify-center text-center">
			<p class="pitch-bold text-[clamp(2rem,5vw,3.75rem)] text-[var(--pitch-red)]">Thank You</p>
			<p class="pitch-bold mt-4 text-[clamp(1rem,2vw,1.35rem)] tracking-[0.18em] uppercase">H.Y.P.E</p>
			<p class="mt-2 text-[clamp(0.8rem,1.3vw,1rem)] text-[var(--pitch-ink-muted)]">Outorbit Games</p>
			<a
				href="mailto:contact@outorbit.games"
				class="mt-8 text-[clamp(0.85rem,1.3vw,1rem)] text-[var(--pitch-red)] underline underline-offset-4"
			>
				contact@outorbit.games
			</a>
		</div>
	</div>
</SlideChrome>
