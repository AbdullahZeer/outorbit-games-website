---
import SlideChrome from '../SlideChrome.astro';

type Segment = {
	id: string;
	label: string;
	games: string;
	reviews: string;
	x: number;
	y: number;
	r: number;
	color: string;
};

const segments: Segment[] = [
	{ id: 'anime-coop', label: 'Anime + online co-op', games: '122 games', reviews: '9,985 reviews', x: 122, y: 9985, r: 12, color: '#7b5ea7' },
	{ id: 'horror-coop', label: 'Horror + online co-op', games: '511 games', reviews: '5,278 reviews', x: 511, y: 5278, r: 14, color: '#2f6fed' },
	{ id: 'online-coop', label: 'Online co-op', games: '3,284 games', reviews: '7,574 reviews', x: 3284, y: 7574, r: 17, color: '#6b8f71' },
	{ id: 'anime', label: 'Anime', games: '5,567 games', reviews: '1,175 reviews', x: 5567, y: 1175, r: 15, color: '#e07a2f' },
	{ id: 'horror', label: 'Horror', games: '6,510 games', reviews: '940 reviews', x: 6510, y: 940, r: 15, color: '#5c3d6e' },
	{ id: 'all', label: 'All released games', games: '63,218 games', reviews: '494 reviews', x: 63218, y: 494, r: 22, color: '#8a8a8a' },
];

function pos(xGames: number, yUpside: number) {
	const minLog = Math.log10(5);
	const maxLog = Math.log10(100000);
	const log = Math.log10(Math.max(xGames, 5));
	const cx = 70 + ((log - minLog) / (maxLog - minLog)) * 700;
	const cy = 36 + (1 - yUpside / 10000) * 250;
	return { cx, cy };
}

const yTicks = [0, 2500, 5000, 7500, 10000];
const xTicks = [
	{ v: 10, label: '10' },
	{ v: 100, label: '100' },
	{ v: 1000, label: '1,000' },
	{ v: 10000, label: '10,000' },
	{ v: 100000, label: '100,000' },
];

const hype = pos(8, 3395);
---

<SlideChrome>
	<div class="flex h-full flex-col">
		<h2 class="pitch-title">Market Opportunity and Competition</h2>
		<p class="pitch-subtitle">A proven market with rare overlap</p>
		<div class="mt-2 min-h-0 flex-1 overflow-hidden rounded-lg bg-white px-2 py-1 text-black shadow-inner">
			<svg
				viewBox="0 0 860 340"
				class="h-full w-full"
				role="img"
				aria-label="Bubble chart comparing segment density to top 10 percent review upside"
			>
				<text x="430" y="18" text-anchor="middle" font-size="11" font-weight="700" fill="#1a1a1a"
					>The HYPE Opportunity: Anime Horror Co-op</text
				>
				<text x="430" y="32" text-anchor="middle" font-size="8" fill="#555"
					>HYPE targets the rare anime + horror + online co-op overlap.</text
				>

				{yTicks.map((v) => {
					const y = 36 + (1 - v / 10000) * 250;
					return (
						<g>
							<line x1="70" y1={y} x2="770" y2={y} stroke="#ddd" stroke-width="1" />
							<text x="62" y={y + 3} text-anchor="end" font-size="7" fill="#666">
								{v === 0 ? '0' : v.toLocaleString('en-US')}
							</text>
						</g>
					);
				})}

				{xTicks.map(({ v, label }) => {
					const minLog = Math.log10(5);
					const maxLog = Math.log10(100000);
					const x = 70 + ((Math.log10(v) - minLog) / (maxLog - minLog)) * 700;
					return (
						<text x={x} y="310" text-anchor="middle" font-size="7" fill="#666">
							{label}
						</text>
					);
				})}

				<text
					x="18"
					y="180"
					text-anchor="middle"
					font-size="7"
					fill="#444"
					transform="rotate(-90 18 180)"
					>TOP-10% REVIEW UPSIDE</text
				>
				<text x="420" y="328" text-anchor="middle" font-size="7" fill="#444"
					>Segment Density (Number of Released Games)</text
				>
				<text x="120" y="298" font-size="7" fill="#2f6fed">← More under-served</text>
				<text x="680" y="298" text-anchor="end" font-size="7" fill="#2f6fed">More crowded →</text>

				<rect
					x={hype.cx - 58}
					y={hype.cy - 88}
					width="150"
					height="108"
					rx="6"
					fill="rgba(201,162,39,0.08)"
					stroke="#c9a227"
					stroke-width="1.5"
					stroke-dasharray="4 3"
				/>
				<text x={hype.cx + 18} y={hype.cy - 70} text-anchor="middle" font-size="14" fill="#c9a227">★</text>
				<text x={hype.cx + 18} y={hype.cy - 54} text-anchor="middle" font-size="8" font-weight="700" fill="#b45309"
					>HYPE TARGET LANE</text
				>
				<text x={hype.cx + 18} y={hype.cy - 42} text-anchor="middle" font-size="6.5" fill="#9a3412"
					>LOW DENSITY · PROVEN UPSIDE</text
				>
				<text x={hype.cx + 18} y={hype.cy - 28} text-anchor="middle" font-size="6" fill="#c2410c"
					>Anime + horror + online co-op</text
				>
				<text x={hype.cx + 18} y={hype.cy - 16} text-anchor="middle" font-size="6" font-weight="700" fill="#c2410c"
					>ONLY 8 RELEASED GAMES</text
				>
				<text x={hype.cx + 18} y={hype.cy - 4} text-anchor="middle" font-size="6" fill="#c2410c"
					>Top-10%: 3,395 reviews</text
				>
				<circle cx={hype.cx} cy={hype.cy} r="9" fill="#e36b6b" stroke="#fff" stroke-width="1" />

				{segments.map((s) => {
					const { cx, cy } = pos(s.x, s.y);
					const labelLeft = s.id === 'all' || s.id === 'anime' || s.id === 'horror';
					const tx = labelLeft ? cx - s.r - 4 : cx + s.r + 4;
					const anchor = labelLeft ? 'end' : 'start';
					return (
						<g>
							<circle cx={cx} cy={cy} r={s.r} fill={s.color} fill-opacity="0.85" stroke="#fff" stroke-width="0.8" />
							<text x={tx} y={cy - 4} text-anchor={anchor} font-size="7" font-weight="600" fill="#222">
								{s.label}
							</text>
							<text x={tx} y={cy + 7} text-anchor={anchor} font-size="6" fill="#555">
								{s.games} · Top-10%: {s.reviews}
							</text>
						</g>
					);
				})}
			</svg>
		</div>
		<div class="mt-2 space-y-1 text-[clamp(0.48rem,0.85vw,0.68rem)] leading-snug text-white/85">
			<p>
				We grouped Steam games by genre/tag overlap, then compared each segment by release count and top-10% review
				performance. Nearby categories show proven demand, while anime + horror + online co-op remains rare, giving HYPE
				a low-competition lane.
			</p>
			<p>
				“Top-10%” means the review count reached by the strongest-performing games in each segment, used here as a signal
				of upside.
			</p>
			<p>Source: GGInsight Released Games on Steam Dataset, February 2025.</p>
		</div>
	</div>
</SlideChrome>
