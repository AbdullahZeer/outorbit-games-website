---
import SlideChrome from '../SlideChrome.astro';
import Tape from '../Tape.astro';
---

<SlideChrome>
	<div class="relative flex h-full items-center justify-center">
		<div class="relative aspect-video w-[min(92%,52rem)] overflow-hidden rounded-sm border border-white/30 bg-black">
			<img
				src="/hype/pitch/art/trailer.webp"
				alt="HYPE prototype trailer still — rumor collection gameplay"
				class="h-full w-full object-cover"
				width="1400"
				height="788"
				loading="lazy"
				decoding="async"
			/>
			<div class="absolute inset-0 flex items-center justify-center bg-black/25" aria-hidden="true">
				<img
					src="/hype/pitch/art/trailer-play.png"
					alt=""
					class="h-[clamp(3.5rem,8vw,5.5rem)] w-[clamp(3.5rem,8vw,5.5rem)] object-contain opacity-95"
					width="120"
					height="120"
				/>
			</div>
			<div class="absolute -left-1 -top-2 z-10 md:-left-2 md:-top-3">
				<div class="relative flex min-h-[2rem] min-w-[6.5rem] items-center justify-center px-3 py-1">
					<Tape src="/hype/pitch/tape/strip-mid.webp" class="absolute inset-0 h-full w-full object-fill rotate-[-6deg]" />
					<span class="pitch-bold relative z-10 text-[clamp(0.7rem,1.2vw,0.95rem)] text-black">Trailer</span>
				</div>
			</div>
		</div>
	</div>
</SlideChrome>
