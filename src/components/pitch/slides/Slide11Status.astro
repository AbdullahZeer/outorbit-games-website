---
import SlideChrome from '../SlideChrome.astro';
---

<SlideChrome>
	<div class="flex h-full flex-col justify-between">
		<div>
			<p class="pitch-bold mb-2 text-[clamp(0.65rem,1.1vw,0.8rem)] tracking-[0.22em] text-[var(--pitch-gold-deep)] uppercase">
				Status
			</p>
			<h2 class="pitch-bold text-[clamp(1.4rem,3.2vw,2.4rem)] leading-[1.05]">
				In development.
			</h2>
			<p class="mt-4 max-w-[44ch] text-[clamp(0.85rem,1.4vw,1.05rem)] leading-relaxed text-[var(--pitch-ink-muted)]">
				PC · Unity · online co-op comedy-horror. Press kit live at outorbit.games/hype.
			</p>
		</div>
		<div class="border-t border-black/10 pt-5">
			<p class="pitch-bold text-[clamp(0.8rem,1.2vw,0.95rem)] tracking-[0.14em] uppercase text-[var(--pitch-ink-muted)]">
				Contact
			</p>
			<a
				href="mailto:contact@outorbit.games"
				class="pitch-bold mt-2 inline-block text-[clamp(1.1rem,2.2vw,1.6rem)] text-[var(--pitch-red)] underline decoration-[var(--pitch-red)]/35 underline-offset-4"
			>
				contact@outorbit.games
			</a>
			<p class="mt-3 text-[clamp(0.75rem,1.15vw,0.9rem)] text-[var(--pitch-ink-muted)]">outorbit.games</p>
		</div>
	</div>
</SlideChrome>
