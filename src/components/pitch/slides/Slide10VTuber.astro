---
import SlideChrome from '../SlideChrome.astro';
---

<SlideChrome>
	<div class="grid h-full grid-cols-[1.1fr_0.9fr] items-center gap-6 md:gap-10">
		<div>
			<h2 class="pitch-title">Creator / VTuber Fit</h2>
			<p class="pitch-subtitle">HYPE is built for anime creators in mind</p>
			<p class="pitch-body mt-[clamp(1.25rem,4vh,2.5rem)] max-w-[30rem]">
				VTubers already love anime and chaotic friendslop games. HYPE gives them a natural format: supernatural anime
				ghost-hunting with friends, where cute school life collides with cursed yokai horror and every run can create
				clip-ready panic.
			</p>
		</div>
		<div class="flex justify-center">
			<article class="w-[min(100%,22rem)] overflow-hidden rounded-xl bg-[#121212] p-3 shadow-xl">
				<img
					src="/hype/pitch/art/vtuber-thumb.webp"
					alt="Example VTuber horror co-op thumbnail"
					class="aspect-video w-full rounded-lg object-cover"
					width="640"
					height="360"
					loading="lazy"
					decoding="async"
				/>
				<p class="pitch-bold mt-3 text-[clamp(0.7rem,1.15vw,0.9rem)] leading-snug">
					The FUNNIEST Horror game Ever! | R.E.P.O.
				</p>
				<div class="mt-3 flex items-center justify-between gap-2">
					<div class="flex items-center gap-2">
						<img
							src="/hype/pitch/art/vtuber-avatar.webp"
							alt=""
							class="h-7 w-7 rounded-full object-cover"
							width="40"
							height="40"
							loading="lazy"
							decoding="async"
						/>
						<span class="text-[clamp(0.65rem,1.05vw,0.8rem)]">chibidoki</span>
					</div>
					<span class="text-[clamp(0.6rem,0.95vw,0.75rem)] text-white/55">Views 295k</span>
				</div>
			</article>
		</div>
	</div>
</SlideChrome>
