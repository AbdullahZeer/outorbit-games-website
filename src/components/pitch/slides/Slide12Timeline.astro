---
import SlideChrome from '../SlideChrome.astro';

const milestones = [
	{ when: 'Q2 2026:', what: 'Core Prototype (validate the case session loop)' },
	{ when: 'Aug 2026:', what: 'Vertical Slice (one complete case with the visual identity, end-to-end)' },
	{ when: 'Q3 - Q4 2026:', what: 'Full Production (scale content and systems)' },
	{ when: 'Q1 2027:', what: 'Alpha (feature-complete, stable co-op sessions)' },
	{ when: 'Q2 - Q3 2027:', what: 'Beta + Launch (polish, release)' },
];
---

<SlideChrome>
	<div class="flex h-full flex-col">
		<h2 class="pitch-title">Production Timeline</h2>
		<p class="pitch-subtitle">HYPE is approaching vertical slice.</p>
		<ol class="relative mt-[clamp(1.5rem,5vh,3rem)] ml-2 list-none border-l-2 border-[var(--pitch-cream)] pl-6 md:ml-4 md:pl-8">
			{
				milestones.map((m) => (
					<li class="relative pb-[clamp(0.85rem,2.8vh,1.6rem)] last:pb-0">
						<span
							class="absolute -left-[1.9rem] top-1.5 h-3 w-3 rounded-full bg-[var(--pitch-cream)] md:-left-[2.4rem] md:h-3.5 md:w-3.5"
							aria-hidden="true"
						/>
						<p class="pitch-body">
							<span class="pitch-bold">{m.when}</span>{' '}
							{m.what}
						</p>
					</li>
				))
			}
		</ol>
		<p class="pitch-body mt-auto text-white/90">
			playtesting is coming soon, with a co-op test build targeted for mid-August
		</p>
	</div>
</SlideChrome>
