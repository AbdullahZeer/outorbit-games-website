---
import SlideChrome from '../SlideChrome.astro';

type Segment = {
	id: string;
	label: string;
	games: string;
	reviewsShort: string;
	x: number;
	y: number;
	r: number;
	color: string;
};

const segments: Segment[] = [
	{ id: 'anime-coop', label: 'Anime + online co-op', games: '122 games', reviewsShort: '9,985 reviews', x: 122, y: 9985, r: 13, color: '#7b5ea7' },
	{ id: 'horror-coop', label: 'Horror + online co-op', games: '511 games', reviewsShort: '5,278 reviews', x: 511, y: 5278, r: 15, color: '#2f6fed' },
	{ id: 'online-coop', label: 'Online co-op', games: '3,284 games', reviewsShort: '7,574 reviews', x: 3284, y: 7574, r: 18, color: '#6b8f71' },
	{ id: 'anime', label: 'Anime', games: '5,567 games', reviewsShort: '1,175 reviews', x: 5567, y: 1175, r: 16, color: '#e07a2f' },
	{ id: 'horror', label: 'Horror', games: '6,510 games', reviewsShort: '940 reviews', x: 6510, y: 940, r: 16, color: '#5c3d6e' },
	{ id: 'all', label: 'All released games', games: '63,218 games', reviewsShort: '494 reviews', x: 63218, y: 494, r: 24, color: '#8a8a8a' },
];

function pos(xGames: number, yUpside: number) {
	const minLog = Math.log10(5);
	const maxLog = Math.log10(100000);
	const log = Math.log10(Math.max(xGames, 5));
	const cx = 78 + ((log - minLog) / (maxLog - minLog)) * 740;
	const cy = 42 + (1 - yUpside / 10000) * 300;
	return { cx, cy };
}

const yTicks = [0, 2500, 5000, 7500, 10000];
const xTicks = [
	{ v: 10, label: '10' },
	{ v: 100, label: '100' },
	{ v: 1000, label: '1,000' },
	{ v: 10000, label: '10,000' },
	{ v: 100000, label: '100,000' },
];

const hype = pos(8, 3395);
---

<SlideChrome>
	<div class="flex h-full flex-col">
		<header class="mb-1 shrink-0 pr-8">
			<h2 class="pitch-bold text-[clamp(1rem,2.1vw,1.55rem)] leading-tight">
				The HYPE Opportunity: Anime Horror Co-op
			</h2>
			<p class="mt-1 text-[clamp(0.68rem,1.1vw,0.88rem)] text-[var(--pitch-gold-deep)] italic">
				HYPE targets the rare anime + horror + online co-op overlap.
			</p>
		</header>

		<div class="relative min-h-0 flex-1">
			<svg
				viewBox="0 0 920 400"
				class="h-full w-full"
				role="img"
				aria-label="Bubble chart comparing segment density to top 10 percent review upside"
			>
				{yTicks.map((v) => {
					const y = 42 + (1 - v / 10000) * 300;
					return (
						<g>
							<line x1="78" y1={y} x2="850" y2={y} stroke="#d8d2c4" stroke-width="1" />
							<text x="70" y={y + 3.5} text-anchor="end" fill="#6a6a6a" font-size="10" font-family="ui-monospace, monospace">
								{v === 0 ? '0' : v.toLocaleString('en-US')}
							</text>
						</g>
					);
				})}

				{xTicks.map(({ v, label }) => (
					<text x={pos(v, 0).cx} y="368" text-anchor="middle" fill="#6a6a6a" font-size="10" font-family="ui-monospace, monospace">
						{label}
					</text>
				))}

				<text transform="translate(16 230) rotate(-90)" fill="#4a4a4a" font-size="9" letter-spacing="0.14em">
					TOP-10% REVIEW UPSIDE
				</text>
				<text x="464" y="390" text-anchor="middle" fill="#4a4a4a" font-size="10">
					Segment Density (Number of Released Games)
				</text>
				<text x="110" y="384" fill="#2f6fed" font-size="9">← More under-served</text>
				<text x="820" y="384" text-anchor="end" fill="#2f6fed" font-size="9">More crowded →</text>

				{/* Target lane callout */}
				<rect
					x={hype.cx - 72}
					y={hype.cy - 98}
					width="178"
					height="118"
					rx="8"
					fill="rgba(201,162,39,0.07)"
					stroke="#c9a227"
					stroke-width="1.75"
					stroke-dasharray="5 4"
				/>
				<text x={hype.cx - 60} y={hype.cy - 76} fill="#c9a227" font-size="16">★</text>
				<text x={hype.cx - 40} y={hype.cy - 76} fill="#1a1a1a" font-size="11" font-weight="700">HYPE</text>
				<text x={hype.cx - 40} y={hype.cy - 62} fill="#1a1a1a" font-size="9" font-weight="700">TARGET LANE</text>
				<text x={hype.cx - 60} y={hype.cy - 46} fill="#5a5a5a" font-size="8">LOW DENSITY · PROVEN UPSIDE</text>
				<text x={hype.cx - 60} y={hype.cy - 28} fill="#df3d1a" font-size="9" font-weight="700">Anime + horror + online co-op</text>
				<text x={hype.cx - 60} y={hype.cy - 14} fill="#df3d1a" font-size="8">ONLY 8 RELEASED GAMES</text>
				<text x={hype.cx - 60} y={hype.cy} fill="#df3d1a" font-size="8">Top-10%: 3,395 reviews</text>
				<circle cx={hype.cx} cy={hype.cy + 28} r="9" fill="#df3d1a" stroke="#fff" stroke-width="1.2" />
				<circle cx={hype.cx} cy={hype.cy + 28} r="10" fill="rgba(0,0,0,0.1)" />

				{segments.map((s) => {
					const { cx, cy } = pos(s.x, s.y);
					const labelLeft = s.id === 'all' || s.id === 'anime' || s.id === 'horror';
					const tx = labelLeft ? cx - s.r - 6 : cx + s.r + 6;
					const anchor = labelLeft ? 'end' : 'start';
					return (
						<g>
							<circle cx={cx} cy={cy} r={s.r + 1.5} fill="rgba(0,0,0,0.12)" />
							<circle cx={cx} cy={cy} r={s.r} fill={s.color} stroke="#fff" stroke-width="1.2" />
							<text x={tx} y={cy - 5} text-anchor={anchor} fill="#1a1a1a" font-size="9.5" font-weight="700">
								{s.label}
							</text>
							<text x={tx} y={cy + 8} text-anchor={anchor} fill="#5a5a5a" font-size="8">
								{s.games} · {s.reviewsShort}
							</text>
						</g>
					);
				})}
			</svg>
		</div>
	</div>
</SlideChrome>
