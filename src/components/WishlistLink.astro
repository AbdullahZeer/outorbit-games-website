---
interface Props {
	/** Distinct utm_content value for this placement. */
	content: string;
	variant?: "solid" | "ghost" | "home";
	size?: "md" | "sm";
	class?: string;
}

import { steamUrl } from "../data/hype";

const { content, variant = "solid", size = "md", class: className = "" } = Astro.props;
const href = steamUrl(content);

const variants = {
	solid: "bg-[#DF3D1A] text-white hover:bg-white hover:text-black",
	ghost: "border border-white/30 text-white hover:border-white hover:bg-white hover:text-black",
	home: "rounded-md bg-[#DF3D1A] text-white hover:bg-white hover:text-black",
};

const sizes = {
	md: "px-5 py-3 text-sm",
	sm: "px-3 py-2 text-xs md:text-sm",
};
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class:list={[
		"inline-flex items-center justify-center text-center tracking-wide transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#DF3D1A]",
		sizes[size],
		variants[variant],
		className,
	]}
>
	Wishlist on Steam
</a>
