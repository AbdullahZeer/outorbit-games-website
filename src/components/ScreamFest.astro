---
interface Props {
	class?: string;
}

import { screamFest } from "../data/hype";

const { class: className = "" } = Astro.props;
---

<!-- Remove after Steam Scream V (Nov 2, 2026): set screamFest.enabled to false in src/data/hype.ts -->
{
	screamFest.enabled && (
		<p class:list={["scream-fest max-w-none text-sm tracking-wide text-[#DF3D1A]", className]}>
			{screamFest.name} · {screamFest.dates}
		</p>
	)
}
